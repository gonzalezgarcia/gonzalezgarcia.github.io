---
layout: default
---
<div class="post">
  <article>
    <div class="about-grid">
      <div class="about-text">
        <h2 class="post-title">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }} {{ site.last_name | replace: ' ', '-' }}</span>
          {% else %}
            {{ site.title }}
          {% endif %}
        </h2>
        <p class="about-role">Ramón y Cajal fellow · CIMCYC, University of Granada</p>

        <div class="about-body">{{ content }}</div>

        {% if page.nav_variant == 'buttons' %}
          <nav class="about-links about-nav" aria-label="Site">
            <a class="action-btn" href="{{ '/' | relative_url }}"><span class="action-label">About</span></a>
            <a class="action-btn" href="{{ '/papers/' | relative_url }}"><span class="action-label">Publications</span></a>
            <a class="action-btn" href="{{ '/resources/' | relative_url }}"><span class="action-label">Resources</span></a>
            <a class="action-btn" href="{{ '/flare/' | relative_url }}"><span class="action-label">FLARE</span></a>
            {% if site.enable_darkmode %}
              <button id="light-toggle" class="action-btn" type="button" title="Change theme">
                <i class="ti ti-sun-moon" id="light-toggle-system"></i>
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            {% endif %}
          </nav>
        {% endif %}

        {% if page.social %}
          <div class="about-links">
            <a class="action-btn" href="mailto:{{ site.email | encode_email }}"><i class="fa-solid fa-envelope"></i><span class="action-label">Email</span></a>
            <a class="action-btn" href="https://scholar.google.com/citations?user={{ site.scholar_userid }}"><i class="ai ai-google-scholar"></i><span class="action-label">Google Scholar</span></a>
            <a class="action-btn" href="https://orcid.org/{{ site.orcid_id }}"><i class="ai ai-orcid"></i><span class="action-label">ORCID</span></a>
            <a class="action-btn" href="https://osf.io/{{ site.osf_id }}/"><i class="ai ai-osf"></i><span class="action-label">OSF</span></a>
            <a class="action-btn" href="https://github.com/{{ site.github_username }}"><i class="fa-brands fa-github"></i><span class="action-label">GitHub</span></a>
            <a class="action-btn" href="https://bsky.app/profile/{{ site.bluesky_url }}"><i class="fa-brands fa-bluesky"></i><span class="action-label">Bluesky</span></a>
          </div>
        {% endif %}
      </div>

      {% if page.profile.image %}
        <img class="about-portrait" src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="{{ page.profile.alt }}" width="200" height="263">
      {% endif %}
    </div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
