---
layout: default
---
<div class="post">
  <article>
    <div class="about-grid">
      <div class="about-text">
        <h2 class="post-title">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }} {{ site.last_name | replace: ' ', '-' }}</span>
          {% else %}
            {{ site.title }}
          {% endif %}
        </h2>
        <p class="about-role">Ramón y Cajal fellow · CIMCYC, University of Granada</p>

        <div class="about-body">{{ content }}</div>

        {% if page.social %}
          <div class="social">
            <div class="contact-icons">{% include social.liquid %}</div>
          </div>
        {% endif %}
      </div>

      {% if page.profile.image %}
        <img class="about-portrait" src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="{{ page.profile.alt }}" width="200" height="263">
      {% endif %}
    </div>

    {% if page.flare_callout %}
      <section class="flare-callout paperslist">
        <div class="paper-card">
          <p class="flare-callout-eyebrow">Current project</p>
          <div class="paper-main">
            <span class="paper-title">FLARE: the representational architecture of fast learning through abstraction</span>
            <span class="paper-venue">{{ page.flare_blurb }}</span>
            <div class="paper-actions">
              <a class="action-btn" href="{{ '/flare/' | relative_url }}"><span class="action-label">Project page</span><i class="fa-solid fa-arrow-right"></i></a>
            </div>
          </div>
        </div>
        <h3 class="flare-callout-heading">Related publications</h3>
        <div class="publications">
          {% bibliography --group_by none -f preprints -T bib_papers -q @*[keywords=flare]* %}
          {% bibliography --group_by none -f papers -T bib_papers -q @*[keywords=flare]* %}
        </div>
      </section>
      <script src="{{ '/assets/js/paperslist.js' | relative_url | bust_file_cache }}"></script>
    {% endif %}

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
