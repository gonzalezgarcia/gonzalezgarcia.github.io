---
layout: default
---
<div class="post">
  <article>
    <div class="about-grid">
      <div class="about-text">
        <h2 class="post-title">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }} {{ site.last_name | replace: ' ', '-' }}</span>
          {% else %}
            {{ site.title }}
          {% endif %}
        </h2>
        <p class="about-role">Ramón y Cajal fellow · CIMCYC, University of Granada</p>

        <div class="about-body">{{ content }}</div>

      </div>

      <div class="about-side">
        {% if page.profile.image %}
          <button class="action-btn about-photo-toggle" type="button" aria-expanded="false" aria-controls="about-portrait">
            <i class="fa-solid fa-image"></i><span class="action-label">This is me!</span>
          </button>
          <img id="about-portrait" class="about-portrait" src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="{{ page.profile.alt }}" width="200" height="263" loading="lazy">
        {% endif %}

        {% if page.social %}
          <div class="social">
            <div class="contact-icons">{% include social.liquid %}</div>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>

<script src="{{ '/assets/js/about.js' | relative_url | bust_file_cache }}" defer></script>
