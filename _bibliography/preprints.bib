@preprint{Cipriani_2026,
   topics = {Working Memory, Attention, Visual Perception & Perceptual Learning},
   author = {Cipriani, Germán A. and González-García, Carlos and Martín-Arévalo, Elisa and Lupiáñez, Juan and Botta, Fabiano},
   title = {Retro-cue Characteristics and Visual Masking Differentially Influence Voluntary and Involuntary Attention},
   year = {2026},
   doi = {10.31234/osf.io/qy6pc_v2},
   url = {https://osf.io/qy6pc_v2},
   pdf = {https://osf.io/qy6pc_v2},
   abstract = {Voluntary and involuntary external attention can differentially modulate perceptual and semantic information, but previous working memory (WM) studies found no corresponding dissociation. Across four experiments (n=140), we tested whether increasing voluntary retro-cue reliability and making involuntary cues fully non-predictive would reveal this dissociation, and whether late visual masking promotes retrospective attention by protecting representations from interference. Peripheral and central retro-cues were used, and performance was analyzed using hierarchical drift-diffusion modeling. No differential prioritization of competing perceptual and semantic WM contents emerged. Beyond this shared pattern, the results revealed distinct influences of cue format, cue reliability, and visual interference on voluntary and involuntary attention. First, increasing central cue reliability enabled voluntary benefits in representational quality that depended on protection from visual interference. Second, peripheral involuntary effects persisted when cue predictiveness was eliminated, whereas evidence for central cues remained ambiguous. Third, removing masking generally did not reduce voluntary retro-cueing effects. Fourth, masking reduced peripheral involuntary benefits in representational quality but enabled retrieval-related benefits, increasing the difference between voluntary and involuntary attention. Finally, more frequent self-reported voluntary cue use was associated with larger attentional effects in the voluntary task, while effects persisted among participants reporting no intentional cue use in the involuntary task. These findings suggest that voluntary and involuntary retrospective attention differ in their sensitivity to cue format, reliability, and visual interference while exerting similar relative effects on competing perceptual and semantic WM representations.},
   award={This is a **preprint**! [Read more](https://en.wikipedia.org/wiki/Preprint)},
   award_name={preprint},
 }
,



