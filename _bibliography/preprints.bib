 	topics = {Instructions & Task Implementation, Cognitive Control},
 	author = {Palenciano, Ana F. and Pena, Paula and Woolgar, Alexandra and González-García, Carlos and Ruz, María},
 	title = {Multiple-Demand Network encoding geometry balances generalization and dimensionality during novel task assembly},
 	elocation-id = {2026.04.22.720093},
 	year = {2026},
 	doi = {10.64898/2026.04.22.720093},
 	publisher = {Cold Spring Harbor Laboratory},
 	abstract = {On the basis of verbal instructions, humans can accomplish novel and diverse demands at the very first try. This complex phenomenon recruits structured brain activity across the frontoparietal system. Here, we test whether the geometry of this activity balances generalization and dimensionality during novel task assembly. Our findings suggest that the multiple-demand network encodes task structure in a way that supports flexible generalization while preserving the specificity required for task performance.},
 	URL = {https://www.biorxiv.org/content/early/2026/04/23/2026.04.22.720093},
