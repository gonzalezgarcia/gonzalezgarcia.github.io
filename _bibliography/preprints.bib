@preprint{Delmarco2026.09.24.754119,
 	topics = {Memory},
   author = {Delmarco, Mattia and González-García, Carlos and Linde-Domingo, Juan},
   title = {Episodic memory adaptively expands retrieval through typicality-guided transformation while concrete details remain accessible},
   elocation-id = {2026.09.24.754119},
   year = {2026},
   doi = {10.64898/2026.09.24.754119},
   publisher = {Cold Spring Harbor Laboratory},
   abstract = {Memory faces a fundamental challenge. It has to become flexible enough to be accessed by novel cues without losing the specific information that defines each individual episode. Whether the memory trace is transformed to focus on the gist of an event or remains anchored to its original specific details remains unclear. Here, we investigate how memory transforms across repeated retrieval opportunities and how this transformation supports flexible, goal-oriented memory use. In a series of experiments, participants encoded and retrieved multiple events while adapting to varying cues. We found that memory traces were progressively transformed in a way that favored typicality-guided retrieval while preserving access to concrete details. This suggests that memory is not a static record but a dynamic representation that balances flexibility and specificity.},
   url = {https://www.biorxiv.org/content/early/2026/09/29/2026.09.24.754119},
   pdf = {https://www.biorxiv.org/content/early/2026/09/29/2026.09.24.754119.full.pdf},
   journal = {bioRxiv},
   award={This is a **preprint**! [Read more](https://en.wikipedia.org/wiki/Preprint)},
   award_name={preprint},
 }


@preprint {Gutirrez-Blanco2026.07.29.741445,
 	topics = {Visual Perception & Perceptual Learning, Social Cognition, Decision-Making},
 	author = {Guti{\'e}rrez-Blanco, Francisco and Gaspar, Sergio and Palenciano, Ana F. and González-García, Carlos and Ruz, Mar{\'\i}a},
 	title = {Flexible predictive processing during face perception},
 	elocation-id = {2026.07.29.741445},
 	year = {2026},
 	doi = {10.64898/2026.07.29.741445},
 	publisher = {Cold Spring Harbor Laboratory},
 	abstract = {Perceptual expectations facilitate perception of expected information by shaping neural coding. However, how the cognitive demands of different tasks may modulate this effect remains unclear. Here, we investigate flexible predictive processing during face perception under varying task demands. We find evidence that predictive processing dynamically adapts to the demands of the perceptual task, suggesting that expectation effects are not fixed but are modulated by context and cognitive goals.},
 	URL = {https://www.biorxiv.org/content/early/2026/08/04/2026.07.29.741445},
 	pdf = {https://www.biorxiv.org/content/early/2026/08/04/2026.07.29.741445.full.pdf},
 	journal = {bioRxiv},
 	award={This is a **preprint**! [Read more](https://en.wikipedia.org/wiki/Preprint)}, 
 	award_name={preprint},
 }
