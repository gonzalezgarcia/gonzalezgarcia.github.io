 @article{Kerr_n_2026,
 topics = {Working Memory, Attention, Decision-Making},
  	title={Characterising semantic prioritisation in visual working memory},
	url={http://dx.doi.org/10.7554/eLife.111859.1},
	doi={10.7554/elife.111859.1},
	journal={eLife},
	author={Kerrén, Casper and González-García, Carlos and Linde-Domingo, Juan},
	abstract = {Cognitive operations require recently encountered information to remain available beyond the moment of sensory input. However, how such transient representations are accessed, and how such information is prioritized during task performance remains unclear. Here, we address this problem by investigating how semantic targets are prioritized among multiple memories. Using a visual working memory task with semantic distractors, we show that semantic cues can selectively bias attention toward task-relevant items. Our data reveal a complex interplay between representation quality, task demands, and attentional selection, suggesting that working memory prioritization is informed by both item-specific and context-dependent factors.},
	year={2026},
	pdf = {kerren2026.pdf},
	}
,
